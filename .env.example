# Copy to `.env` for local dev (Metro / Expo Go). Values are gitignored.
# Project Settings → API → Project URL and anon/public key.
#
# EAS internal / store builds do NOT use this file. Set the same variables on Expo:
#   eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL --value "https://YOUR_REF.supabase.co"
#   eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "YOUR_ANON_KEY"
# Repeat for production (and development if you use eas build --profile development).
# Then rebuild: eas build --profile preview --platform android
#
# See docs/eas-supabase-setup.md for full steps.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Dashboard → Authentication → URL Configuration:
# Site URL (production builds): workouttracker:///auth/callback
# Redirect URLs (add all that apply):
#   workouttracker:///auth/callback
#   workouttracker://auth/callback
#   workouttracker://**
#   exp://**   (required for Expo Go email-confirm testing)
#
# Expo Go: sign-up emails embed your Metro URL (exp://192.168.x.x:8081/--/auth/callback).
# Keep Metro running and resend confirmation if your PC IP changes.
#
# Auth emails (confirm sign-up, password reset) are sent by Supabase Auth.
# Configure custom SMTP in the Supabase Dashboard (not in this file):
#   Authentication → SMTP Settings → Resend (see supabase/RESEND_SMTP_SETUP.md)
